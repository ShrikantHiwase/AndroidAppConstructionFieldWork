	<string>Record voice notes on DPR and issues for one-handed site capture.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Attach GPS to field records and check labour muster geofence.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Unlock Field Evidence after app resume.</string>
