# Keep generated / IDE noise out of the monorepo root.
.DS_Store
*.iml
.idea/
.vscode/
*.log

# Flutter / Dart
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/

# Firebase
firebase/.runtimeconfig.json
firebase/functions/node_modules/
firebase/functions/lib/

# Secrets — never commit
**/google-services.json
**/GoogleService-Info.plist
.env
.env.*

# firebase_options.dart is committed as a placeholder (isConfigured=false).
# After flutterfire configure, commit the regenerated file with isConfigured=true.
# Platform credential JSON/plist files remain gitignored above.
